# ─────────────────────────────────────────────────────────────────────────────
# LAGALia v2 — Variables d'entorn
#
# Copia aquest fitxer a `.env` i omple els valors. El `.env` NO es versiona.
#
# Regla del projecte: aquí només hi ha secrets d'infraestructura. Les credencials
# operatives (proveïdors d'IA, connectors, tokens per usuari) es gestionen des de
# l'aplicació i es guarden XIFRADES a la base de dades amb ENCRYPTION_KEY.
# Vegeu docs/06-seguretat.md §4.
#
# L'aplicació NO arrenca en producció si falta un valor marcat [OBLIGATORI].
# ─────────────────────────────────────────────────────────────────────────────

# ── Bàsic ────────────────────────────────────────────────────────────────────
ENVIRONMENT=development                 # development | staging | production
DEBUG=true                              # sempre false en producció
APP_VERSION=0.1.0

# ── Base de dades ────────────────────────────────────────────────────────────
# [OBLIGATORI] PostgreSQL 16 amb extensions pgvector i pg_trgm.
DATABASE_URL=postgresql+asyncpg://lagalia:lagalia@localhost:5432/lagalia

# ── Cua de treballs i cache ──────────────────────────────────────────────────
# [OBLIGATORI]
REDIS_URL=redis://localhost:6379/0

# ── Criptografia ─────────────────────────────────────────────────────────────
# [OBLIGATORI] Signatura de tokens de sessió. Genera'l amb:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# Mai un valor per defecte: canviar-lo invalida totes les sessions.
SECRET_KEY=

# [OBLIGATORI] Clau mestra de xifrat (AES-256-GCM) dels secrets guardats a la BD.
#   python -c "import base64,os; print(base64.b64encode(os.urandom(32)).decode())"
# ⚠️ Si es perd, les credencials xifrades són irrecuperables. Guarda-la al gestor
#    de secrets de l'organització i documenta'n la rotació.
ENCRYPTION_KEY=

ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Xarxa ────────────────────────────────────────────────────────────────────
# Orígens permesos per al navegador (JSON). Mai "*" amb credencials.
CORS_ORIGINS=["http://localhost:5173"]

# Proxy de confiança del qual s'accepta X-Forwarded-For (per a rate limiting i
# auditoria correctes darrere Caddy/Nginx). Buit = no confiar en cap.
TRUSTED_PROXY_IPS=

# ── Emmagatzematge d'objectes (documents descarregats i generats) ────────────
# backend: filesystem | s3
STORAGE_BACKEND=s3
STORAGE_LOCAL_PATH=./storage
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=lagalia
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ── Observabilitat ───────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=json
OTEL_EXPORTER_OTLP_ENDPOINT=

# ── Límits de petició ────────────────────────────────────────────────────────
RATE_LIMIT_LOGIN=5/minute
RATE_LIMIT_API=100/minute
RATE_LIMIT_AI=30/minute
RATE_LIMIT_SYNC=10/minute

# ─────────────────────────────────────────────────────────────────────────────
# NO POSIS AQUÍ (es configuren des de l'aplicació i es desen xifrats):
#   · claus d'API de proveïdors d'IA (OpenAI-compatible, Gemini, Claude)
#   · credencials de connectors (Gestiona addon token, LDAP, SMTP)
#   · tokens d'usuari de Gestiona
#   · URLs de webhooks sortints i els seus secrets
# ─────────────────────────────────────────────────────────────────────────────
