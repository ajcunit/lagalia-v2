# ─────────────────────────────────────────────────────────────────────────────
# LAGALia v2 — Variables d'entorn
#
# Copia aquest fitxer a `.env` i omple els valors. El `.env` NO es versiona.
#
# Regla del projecte: aquí només hi ha secrets d'infraestructura. Les credencials
# operatives (proveïdors d'IA, connectors, tokens per usuari) es gestionen des de
# l'aplicació i es guarden XIFRADES a la base de dades amb ENCRYPTION_KEY.
# Vegeu docs/06-seguretat.md §4.
#
# L'aplicació NO arrenca en producció si falta un valor marcat [OBLIGATORI].
# ─────────────────────────────────────────────────────────────────────────────

# ── Bàsic ────────────────────────────────────────────────────────────────────
ENVIRONMENT=development                 # development | staging | production
DEBUG=true                              # sempre false en producció
APP_VERSION=0.1.0

# ── Base de dades ────────────────────────────────────────────────────────────
# [OBLIGATORI] PostgreSQL 16 amb extensions pgvector i pg_trgm.
DATABASE_URL=postgresql+asyncpg://lagalia:lagalia@localhost:5432/lagalia

# ── Cua de treballs i cache ──────────────────────────────────────────────────
# [OBLIGATORI]
REDIS_URL=redis://localhost:6379/0

# ── Criptografia ─────────────────────────────────────────────────────────────
# [OBLIGATORI] Signatura de tokens de sessió. Genera'l amb:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# Mai un valor per defecte: canviar-lo invalida totes les sessions.
SECRET_KEY=

# [OBLIGATORI] Clau mestra de xifrat (AES-256-GCM) dels secrets guardats a la BD.
#   python -c "import base64,os; print(base64.b64encode(os.urandom(32)).decode())"
# ⚠️ Si es perd, les credencials xifrades són irrecuperables. Guarda-la al gestor
#    de secrets de l'organització i documenta'n la rotació.
ENCRYPTION_KEY=

ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Xarxa ────────────────────────────────────────────────────────────────────
# Orígens permesos per al navegador (JSON). Mai "*" amb credencials.
CORS_ORIGINS=["http://localhost:5173"]

# Només al servidor (docker-compose.prod.yml): adreça amb què Caddy serveix la
# SPA i fa de reverse proxy cap a l'API. `https://nom` = TLS automàtic,
# `nom.local` = certificat intern, `:80` = HTTP pla amb un altre proxy davant.
# SITE_ADDRESS=https://lagalia.cunit.cat

# Proxys de confiança dels quals s'accepta X-Forwarded-For (per a rate limiting
# i auditoria correctes darrere Caddy/Nginx). IPs exactes o rangs CIDR,
# separats per comes. Buit = no confiar en cap capçalera. ⚠️ Darrere d'un proxy
# sense declarar-lo aquí, tots els usuaris comparteixen el límit de login i
# l'auditoria registra la IP del proxy.
#
# ⚠️ Amb Docker NO hi va la IP del servidor: el contenidor veu la passarel·la
# de la xarxa del compose (proxy al host) o la IP del contenidor del proxy
# (que canvia a cada reinici). El valor pràctic és el rang privat de Docker:
#   TRUSTED_PROXY_IPS=172.16.0.0/12
# És segur perquè l'API només es publica a 127.0.0.1: només el host hi arriba.
TRUSTED_PROXY_IPS=

# ── Emmagatzematge d'objectes (documents descarregats i generats) ────────────
# backend: filesystem | s3
STORAGE_BACKEND=s3
STORAGE_LOCAL_PATH=./storage
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=lagalia
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ── Observabilitat ───────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=json
OTEL_EXPORTER_OTLP_ENDPOINT=

# ── Límits de petició ────────────────────────────────────────────────────────
RATE_LIMIT_LOGIN=5/minute
# Els límits per API/IA/sincronització encara no s'apliquen (BACKLOG B-019).

# ─────────────────────────────────────────────────────────────────────────────
# NO POSIS AQUÍ (es configuren des de l'aplicació i es desen xifrats):
#   · claus d'API de proveïdors d'IA (OpenAI-compatible, Gemini, Claude)
#   · credencials de connectors (Gestiona addon token, LDAP, SMTP)
#   · tokens d'usuari de Gestiona
#   · URLs de webhooks sortints i els seus secrets
# ─────────────────────────────────────────────────────────────────────────────
